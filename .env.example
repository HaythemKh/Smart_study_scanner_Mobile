# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
# Get from: https://console.cloud.google.com/apis/credentials
# This is the Web Client ID (not Android or iOS client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
# URL to your Smart Study Scanner API backend
# 
# For physical devices on local network:
# Use your computer's IP address (find with: ipconfig on Windows or ifconfig on Mac/Linux)
EXPO_PUBLIC_API_URL="http://YOUR_IP_ADDRESS:3000/api"

# Examples for different environments:
# Local network: http://192.168.1.100:3000/api
# Android emulator: http://10.0.2.2:3000/api
# iOS simulator: http://localhost:3000/api
# Production: https://your-api-domain.com/api
